#!/usr/bin/env bash
# claude-box — run Claude Code in a container, unprompted, scoped to $PWD.
#
#   claude-box                 launch Claude Code with permission prompts off
#   claude-box shell           drop into a shell in the container instead
#   claude-box -- --continue   pass extra flags through to claude
#
# Per-project state lives in ./.claude-box/ (self-gitignored):
#   node_modules, .venv   the box's own Linux installs, mounted over the
#                         project's (see "Platform-specific dirs" below)
#   dirs                  more paths to treat that way, one per line
#   env                   extra environment for the container
#
set -euo pipefail

IMAGE="${CLAUDE_BOX_IMAGE:-claude-box}"
VOLUME="${CLAUDE_BOX_VOLUME:-claude-box-config}"
HOST_CLAUDE="${HOME}/.claude"
GUEST_CLAUDE="/home/node/.claude"

# --- Container runtime.
# Work machines have podman, the Mac has docker via OrbStack. Same CLI surface
# for everything used here, so just take whichever is installed.
RUNTIME="${CLAUDE_BOX_RUNTIME:-$(command -v podman || command -v docker || true)}"
if [ -z "${RUNTIME}" ]; then
  echo "claude-box: neither podman nor docker found on PATH" >&2
  exit 1
fi

args=(
  --rm --interactive --tty
  --hostname claude-box
  --volume "${PWD}:/workspace"
  --workdir /workspace
  --volume "${VOLUME}:${GUEST_CLAUDE}"
  --env "CLAUDE_CONFIG_DIR=${GUEST_CLAUDE}"
  # docker run defaults to TERM=xterm (8 colors) and drops COLORTERM, which
  # leaves Claude Code's highlights washed out and Helix without a visible
  # cursor. Forward the host's values so the container sees true color.
  --env "TERM=${TERM:-xterm-256color}"
  --env "COLORTERM=${COLORTERM:-truecolor}"
  # Host networking so servers Claude starts in the box (gocr serve, npm run
  # dev, ...) are reachable at localhost on the host with no port list to
  # maintain, and the host's MCP servers are reachable from the box (see
  # "Host MCP servers" below). Works because OrbStack does real host
  # networking on macOS; loopback-bound servers like gocr's 127.0.0.1
  # wouldn't survive -p anyway.
  --network host
)

# --- Host-authored config, mounted read-only over the volume.
# Docker applies mounts deepest-path-last, so these land on top of the volume
# rather than being shadowed by it. Read-only means the container can't corrupt
# the skills and settings you maintain on the host.
# Only mount paths that actually exist — Docker silently creates a root-owned
# empty directory for a missing bind source, which then shadows the real thing.
for item in skills agents commands output-styles settings.json CLAUDE.md; do
  if [ -e "${HOST_CLAUDE}/${item}" ]; then
    args+=(--volume "${HOST_CLAUDE}/${item}:${GUEST_CLAUDE}/${item}:ro")
  fi
done

# --- Symlinked skills.
# Bind mounts don't follow symlinks, so a skill that's a link to somewhere
# outside ~/.claude/skills (e.g. a skill kept in its own repo) dangles inside
# the box and Claude Code silently skips it. Mount each link's real target on
# top of the skills mount at the same name. Deeper paths mount last, so these
# land over the parent mount rather than being shadowed by it.
if [ -d "${HOST_CLAUDE}/skills" ]; then
  for link in "${HOST_CLAUDE}"/skills/*; do
    [ -L "$link" ] || continue
    target="$(cd "$(dirname "$link")" && cd "$(readlink "$link")" 2>/dev/null && pwd -P)" || continue
    args+=(--volume "${target}:${GUEST_CLAUDE}/skills/$(basename "$link"):ro")
  done
fi

# --- Per-project dir.
# Everything claude-box keeps for a project lives in ./.claude-box/, so it's
# obvious where it is and goes away with the project. The dir ignores itself
# via a .gitignore inside it (git add -f if you ever want dirs committed).
BOX="${PWD}/.claude-box"
mkdir -p "${BOX}"
[ -e "${BOX}/.gitignore" ] || printf '*\n' > "${BOX}/.gitignore"

# --- Platform-specific dirs.
# The problem is that node_modules and .venv hold binaries built for whichever
# side ran the install last, so a Linux install from the box breaks the Mac
# checkout and vice versa. The way we solve this is to mount .claude-box/<dir>
# on top of each such path, so the box gets its own Linux copy that persists
# across launches while the host copy underneath is never touched. Deeper
# paths mount last, so these land over the /workspace mount.
# Defaults cover node and python; .claude-box/dirs adds more (target, .tox,
# packages/web/node_modules, ...), one relative path per line, # comments
# allowed. Safe to rm -rf .claude-box; the box just reinstalls.
# Understand: the mountpoint is created on the host first so it's owned by you
# rather than by whatever the runtime creates it as. Empty dirs are invisible
# to git, so the leftover node_modules/.venv on the host cost nothing.
mask_dirs=(node_modules .venv)
if [ -f "${BOX}/dirs" ]; then
  while IFS= read -r line || [ -n "$line" ]; do
    line="${line%%#*}"; line="${line#"${line%%[![:space:]]*}"}"; line="${line%"${line##*[![:space:]]}"}"
    [ -n "$line" ] && mask_dirs+=("${line#/}")
  done < "${BOX}/dirs"
fi
for dir in "${mask_dirs[@]}"; do
  dir="${dir%/}"
  case "$dir" in ""|.|..|../*|*/../*|*/..|.claude-box|.claude-box/*) continue ;; esac
  mkdir -p "${PWD}/${dir}" "${BOX}/${dir}"
  args+=(--volume "$(realpath "${BOX}/${dir}"):/workspace/${dir}")
done
# Hide .claude-box inside the box: otherwise the same node_modules shows up
# twice in the tree and crawlers like Jest's haste map complain about
# duplicate packages. An empty read-only tmpfs over it does the job; nothing
# in there is needed from inside.
args+=(--tmpfs /workspace/.claude-box:ro)

# --- Scratchpad on the host.
# Claude Code writes artifacts and working files to /tmp/claude-<uid>/... inside
# the box, which is container-private and gone on exit. Back it with a host
# dir so you can open what it makes (open /tmp/claude-box/...) and it outlives
# the container. Kept under /tmp so it's scratch on the host too, cleared on
# reboot rather than piling up. The uid is 1000 unless the image was built
# with --build-arg UID on Linux.
SCRATCH="${CLAUDE_BOX_SCRATCH:-/tmp/claude-box}"
mkdir -p "${SCRATCH}"
# Resolve symlinks (e.g. macOS's /tmp -> /private/tmp) before handing this to
# podman: podman machine's VM only shares specific host dirs over virtiofs
# (/Users, /private, /var/folders) and has its own separate /tmp, so the
# literal path /tmp/claude-box doesn't resolve inside the VM even though
# mkdir -p just created it on the host.
SCRATCH="$(realpath "${SCRATCH}")"
args+=(--volume "${SCRATCH}:/tmp/claude-${CLAUDE_BOX_UID:-1000}")

# --- Host MCP servers.
# The MCP servers registered on the host (bear, leonardo, ...) live in
# ~/.claude.json, which stays on the host — the box has its own config in the
# volume, so it can't see them. Copy their definitions out into a file the box
# loads via --mcp-config, so whatever you `claude mcp add` on the host is in
# the box next launch with no list to maintain.
# Only http/sse servers come across: with --network host their localhost URLs
# already resolve from inside the box. stdio servers would need their command
# installed in the image, so they're dropped.
# Understand: podman on macOS runs containers in a VM, so --network host is
# the VM's network and the Mac is host.containers.internal, not localhost.
# Rewrite the URLs in that case. Linux podman and OrbStack docker share the
# real host network and need no rewrite.
HOST_MCP="${SCRATCH}/host-mcp.json"
MCP_HOST="${CLAUDE_BOX_MCP_HOST:-localhost}"
if [ "${MCP_HOST}" = "localhost" ] && [[ "${RUNTIME}" == *podman* ]] && [ "$(uname -s)" != "Linux" ]; then
  MCP_HOST="host.containers.internal"
fi
if [ -f "${HOME}/.claude.json" ] && command -v jq >/dev/null; then
  jq --arg host "${MCP_HOST}" '{
    mcpServers: (.mcpServers // {}
      | with_entries(select(.value.type == "http" or .value.type == "sse"))
      | map_values(.url |= sub("^(?<s>https?://)(localhost|127\\.0\\.0\\.1)"; "\(.s)\($host)")))
  }' "${HOME}/.claude.json" > "${HOST_MCP}"
else
  echo '{"mcpServers":{}}' > "${HOST_MCP}"
fi
args+=(--volume "${HOST_MCP}:/opt/claude-box/host-mcp.json:ro")

# --- Git identity and global config from the host, read-only.
# Without these, commits inside the box fail with "please tell me who you
# are". ~/.config/git carries the global ignore file.
[ -f "${HOME}/.gitconfig" ] && args+=(--volume "${HOME}/.gitconfig:/home/node/.gitconfig:ro")
[ -d "${HOME}/.config/git" ] && args+=(--volume "${HOME}/.config/git:/home/node/.config/git:ro")

# --- Helix config from the host (config.toml, languages.toml, themes).
# Read-only: edit it on the host, the container picks it up next launch.
if [ -d "${HOME}/.config/helix" ]; then
  args+=(--volume "${HOME}/.config/helix:/home/node/.config/helix:ro")
fi

# --- Auth.
# Preferred: sign in once inside the container; the token persists in $VOLUME.
# Alternative: export CLAUDE_CODE_OAUTH_TOKEN=$(claude setup-token) on the host
# and it gets passed through here.
if [ -n "${CLAUDE_CODE_OAUTH_TOKEN:-}" ]; then
  args+=(--env CLAUDE_CODE_OAUTH_TOKEN)
fi

# --- Optional per-project extras.
# .claude-box/env is passed through as environment (KEY=value lines).
if [ -f "${BOX}/env" ]; then
  args+=(--env-file "${BOX}/env")
fi

if [ "${1:-}" = "shell" ]; then
  shift
  cmd=(bash "$@")
else
  [ "${1:-}" = "--" ] && shift
  # --mcp-config registers the in-image Playwright (headless Chromium) server
  # so Claude can take screenshots and drive pages from inside the box, plus
  # the host's MCP servers exported above.
  cmd=(claude --dangerously-skip-permissions
       --mcp-config /opt/claude-box/mcp.json /opt/claude-box/host-mcp.json "$@")
fi

# Tells herdr which screen-detection manifest to use, since it sees `docker`
# as the pane's foreground process rather than `claude`. Must be set on the
# host side of the command — herdr can't see it if it's set in the container.
export HERDR_AGENT=claude

[ -n "${CLAUDE_BOX_DRYRUN:-}" ] && { printf "%s\n" "${RUNTIME}" "${args[@]}" "${IMAGE}" "${cmd[@]}"; exit 0; }
exec "${RUNTIME}" run "${args[@]}" "${IMAGE}" "${cmd[@]}"
